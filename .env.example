# Google Analytics 4 Configuration
# Get your Measurement ID from: https://analytics.google.com
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact email for privacy policy and legal notices
VITE_CONTACT_EMAIL=privacy@example.com

# Google AdSense display ad unit ID (data-ad-slot) for the BankCEO in-game banner
# Create a display ad unit in AdSense > Ads > By ad unit. Leave empty to disable the ad.
VITE_ADSENSE_GAME_SLOT=
